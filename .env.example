# Copy to .env and fill in. Never commit .env.

APP_URL=https://www.audioeditscuts.com

# PayPal → developer.paypal.com → Apps & Credentials
# Use Live credentials for real money (toggle Live in the dashboard).
PAYPAL_MODE=live
PAYPAL_CLIENT_ID=your_live_client_id
PAYPAL_CLIENT_SECRET=your_live_secret

# Admin bypass — unlock downloads with no charge.
ADMIN_PASSWORD=change-me-admin-password
ADMIN_COOKIE_SECRET=change-me-long-random-string
