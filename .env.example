# Copy to .env and fill in. Never commit .env.

APP_URL=http://127.0.0.1:8765

# Supabase → Project Settings → API
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
# Project Settings → API → JWT Secret
SUPABASE_JWT_SECRET=your_jwt_secret

# PayPal → developer.paypal.com → Apps & Credentials
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=your_paypal_client_id
PAYPAL_CLIENT_SECRET=your_paypal_secret
# Create this after the app is public/local tunneled. Webhook URL:
# https://yourdomain.com/api/paypal/webhook
PAYPAL_WEBHOOK_ID=
# Optional: paste the weekly plan id after first subscription checkout prints it.
PAYPAL_PLAN_WEEKLY=

# Admin bypass — type this password in the paywall to download with no charge.
ADMIN_PASSWORD=change-me-admin-password
ADMIN_COOKIE_SECRET=change-me-long-random-string
